# ───────── Copia estas variables en Railway → tu servicio → Variables (NO subas un .env real a GitHub) ─────────

# Telegram (obligatorio para recibir señales)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# BingX (solo necesario si TRADING_MODE=live). Crea la API key con permisos de LECTURA + TRADING de futuros, SIN retiros.
BINGX_API_KEY=
BINGX_API_SECRET=
BINGX_SANDBOX=false          # true = cuenta demo VST de BingX (recomendado para probar la ejecución)
HEDGE_MODE=true              # BingX usa modo hedge por defecto. El bot intenta fijarlo al arrancar.
MARGIN_MODE=isolated

# Modo: signals = solo avisos por Telegram (empieza SIEMPRE aquí) | live = opera en BingX
TRADING_MODE=signals
LONG_ENABLED=true
SHORT_ENABLED=true

# Riesgo (solo aplica en live)
RISK_PCT=0.5                 # % del equity que arriesgas por operación
LEVERAGE=5
MAX_OPEN_POSITIONS=3
DAILY_LOSS_LIMIT_PCT=3       # si el equity cae esto en el día (UTC), el bot deja de abrir operaciones
SL_ATR_MULT=1.5              # SL = 1.5 x ATR "normal" de 15m (mínimo MIN_SL_PCT)
TP_R_MULT=2.0                # TP = 2R
MIN_SL_PCT=0.35
MAX_SL_PCT=3.0
MAX_HOLD_HOURS=10            # cierra a mercado si pasan tantas horas
SYMBOL_COOLDOWN_HOURS=6
MAX_CHASE_ATR=1.0

# Escáner
SCAN_TIMEFRAME=15m
MIN_QUOTE_VOLUME_USDT=3000000   # liquidez mínima 24h por moneda
MAX_SYMBOLS=0                    # 0 = todas las que pasen el filtro de liquidez
MAX_SPREAD_PCT=0.15
MIN_ADR_PCT=2.0                  # descarta monedas "dormidas"
MAX_ROOM_RATIO=2.0               # descarta si hoy ya recorrió más de 2x su rango diario medio
USE_BTC_FILTER=true

# Puntuación
MIN_SCORE_ALERT=65               # a partir de aquí avisa por Telegram
MIN_SCORE_TRADE=75               # a partir de aquí opera (solo explosiones confirmadas)
MAX_ALERTS_PER_SCAN=6
SIGNAL_COOLDOWN_MIN=120
HEARTBEAT_HOURS=6

LOG_LEVEL=INFO
